{
  "_meta": {
    "title": "RealESRGAN x4 super-resolution (post-process)",
    "tier": "aux",
    "mode": "upscale",
    "model": "RealESRGAN_x4plus.pth",
    "notes": "Run AFTER Wan generation while gen models are unloaded. Input: LoadImage. Output: SaveImage. ~4x linear (512→2048)."
  },
  "prompt": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "INPUT_IMAGE.png"
      }
    },
    "2": {
      "class_type": "UpscaleModelLoader",
      "inputs": {
        "model_name": "RealESRGAN_x4plus.pth"
      }
    },
    "3": {
      "class_type": "ImageUpscaleWithModel",
      "inputs": {
        "upscale_model": ["2", 0],
        "image": ["1", 0]
      }
    },
    "4": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "upscale_x4",
        "images": ["3", 0]
      }
    }
  }
}
